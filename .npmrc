# Install behaviour, chosen for supply-chain reasons rather than convenience.
#
# ── WHY EVERY VERSION IN package.json IS EXACT ───────────────────────────────
#
# A caret range says "any compatible newer version is fine". That is a standing
# instruction to run code nobody here has looked at, on whatever machine next
# runs an install. Most supply-chain compromises of the last few years arrived
# exactly that way: a maintainer account is taken over, a patch release is
# published, and every project with a caret picks it up on the next CI run
# without a commit, a review, or a diff.
#
# Exact versions turn an upgrade into a pull request. That is the whole point.
# `pnpm outdated` still shows what has moved; upgrading is deliberate.

save-exact=true

# A lockfile that can be quietly rewritten during an install is not a lockfile.
# CI installs must fail on a mismatch rather than resolve something new.
prefer-frozen-lockfile=true

# Refuse to install under a package manager or Node version other than the one
# the lockfile was produced with. Silent drift between a developer's machine
# and the deploy is how "works locally" becomes a production incident.
engine-strict=true

# Peer resolution is left at pnpm's defaults on purpose. Changing it here
# invalidates the existing lockfile (`ERR_PNPM_LOCKFILE_CONFIG_MISMATCH`), and
# forcing a full re-resolve to tighten a preference that is not a security
# control trades a known-good dependency graph for an unknown one. That is the
# wrong direction for a hardening change.

# Fail rather than prompt when something is ambiguous in a non-interactive run.
# A build that waits for input has already failed, it just has not said so.
fund=false
audit=false
