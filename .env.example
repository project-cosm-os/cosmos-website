# CosmOS AI website, environment variables.
#
# ── THE VITE_ PREFIX IS THE SECURITY BOUNDARY ────────────────────────────────
#
# Vite compiles every VITE_-prefixed variable into the JavaScript it ships.
# That is documented behaviour, not a leak, and it means:
#
#   VITE_*       PUBLIC. Anyone can read it in the bundle. Only put things here
#                that are public anyway: a provider name, a HubSpot form id.
#
#   no prefix    SERVER ONLY. Never reaches the browser. Read at request time
#                by the Netlify Functions in netlify/functions/.
#
# Never add a VITE_ prefix to something you do not want scraped. There is no
# way to un-ship it once a build goes out.
#
# Copy to .env for local development. In production these are set in the
# Netlify dashboard, not in any file.


# ── Server only: never compiled into the site ───────────────────────────────

# The Google Calendar appointment schedule URL. It MUST be the embeddable one:
#
#   works    https://calendar.google.com/calendar/appointments/schedules/<id>?gv=true
#   does not https://calendar.app.google/<short>
#   does not https://calendar.google.com/appointments/schedules/<id>
#
# The share button and the short link both give you a page Google serves with
# `x-frame-options: SAMEORIGIN`, so the embed renders an empty box and nothing
# else looks wrong. Measured, not assumed. The two long forms are rewritten
# automatically by src/integrations/scheduling/normalise.ts; a short link cannot
# be, because the schedule id is not in it. Open it in a browser and copy the
# full URL from the address bar.
#
# Kept out of the bundle so it cannot be scraped from the HTML, the JS or this
# repository. Note the honest limit: once a visitor opens the booking embed,
# the redirect target is visible in their devtools network panel. The browser
# has to reach Google for the page to render. This stops bulk scraping, not a
# person who goes looking.
SCHEDULING_URL=


# ── Public: compiled into the bundle ────────────────────────────────────────

# google | calendly | none
VITE_SCHEDULING_PROVIDER=google

# Only read when VITE_SCHEDULING_PROVIDER=calendly. Public by nature.
VITE_CALENDLY_URL=

# netlify | hubspot | none
VITE_FORMS_PROVIDER=netlify

# Only read when VITE_FORMS_PROVIDER=hubspot. Both are public identifiers that
# appear in HubSpot's own embed snippet, not credentials.
VITE_HUBSPOT_PORTAL_ID=
VITE_HUBSPOT_FORM_ID=

# A CosmOS PostHog project. Do NOT paste a key from another product: it would
# route every visitor here into that product's funnel.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_GA4_MEASUREMENT_ID=


# ── Not an environment variable at all ──────────────────────────────────────
#
# The form notification address is set in the Netlify dashboard, under
# Forms → Form notifications. It is deliberately not here and not in
# netlify.toml, so no file in this repository names who receives a submission.
